# === JustMine production/runtime environment template ===
# Copy this file to .env.justmine on the server and replace placeholders there.
# Keep real secrets out of GitHub.

# AI runtime mode
# true  = allow deterministic mock replies when real keys are not injected
# false = require real model credentials for production agent execution
AI_MOCK_MODE=true

# AI models
DEEPSEEK_API_KEY=__REPLACE_WITH_REAL_DEEPSEEK_KEY__
DASHSCOPE_API_KEY=__REPLACE_WITH_REAL_DASHSCOPE_KEY__

# WeCom callback and broadcast
WECHAT_CORP_ID=__REPLACE_WITH_REAL_CORP_ID__
WECHAT_TOKEN=__REPLACE_WITH_REAL_TOKEN__
WECHAT_ENCODING_AES_KEY=__REPLACE_WITH_REAL_AES_KEY__
WECOM_AGENT_ID=__REPLACE_WITH_REAL_AGENT_ID__
WECOM_APP_SECRET=__REPLACE_WITH_REAL_APP_SECRET__
WECOM_WEBHOOK_URL=__REPLACE_WITH_REAL_WECOM_WEBHOOK__

# Notion archive and market intelligence records
NOTION_API_KEY=__REPLACE_WITH_REAL_NOTION_KEY__
NOTION_ARCHIVE_DATABASE_ID=__REPLACE_WITH_REAL_ARCHIVE_DATABASE_ID__
NOTION_SCOUT_DATABASE_ID=__REPLACE_WITH_REAL_SCOUT_DATABASE_ID__

# System
DASHBOARD_PASS=__REPLACE_WITH_REAL_DASHBOARD_PASSWORD__
JWT_SECRET=__REPLACE_WITH_RANDOM_JWT_SECRET__
ALLOWED_ORIGINS=http://localhost,https://www.justmine.cn
